  m_Name: ArrivalGuideTexts
  m_EditorClassIdentifier: Kizami.EngineAdapter.Runtime::Kizami.EngineAdapter.StageGuideTexts
  _objective: "\u5929\u7167\u5854\u3092\u5012\u3057\u3066\u5916\u3078\u306E\u9053\u3092\u4F5C\u308A\u3001\u8131\u51FA\u5730\u70B9\u306B\u305F\u3069\u308A\u7740\u3051"
  _steps:
  - _subObjective: "\u5929\u7167\u5854\u306E\u6839\u5143\u3092\u58CA\u3057\u3066\u5012\u305B"
    _dialogue: "\u3042\u306E\u5854\u304C\u5012\u308C\u308C\u3070\u3001\u5916\u3078\u7D9A\u304F\u9053\u304C\u3067\u304D\u308B\u3002\u5854\u306E\u6839\u5143\u3092\u58CA\u3057\u3066\u3001\u50BE\u3044\u3066\u3044\u308B\u5074\u3078\u5012\u305D\u3046\u3002\u5236\u9650\u6642\u9593\u304C\u3042\u308B\u306E\u3067\u6025\u3052\u3002"
  - _subObjective: "\u9053\u306E\u6575\u3092\u5012\u3057\u3066\u9032\u3081"
    _dialogue: "\u9053\u304C\u3067\u304D\u305F\u3002\u3060\u304C\u6575\u3082\u305D\u3053\u304B\u3089\u51FA\u3066\u304F\u308B\u3002\u5012\u3057\u306A\u304C\u3089\u5148\u3078\u9032\u3082\u3046\u3002"
  - _subObjective: "\u8131\u51FA\u5730\u70B9\u3092\u58CA\u305B"
    _dialogue: "\u8131\u51FA\u5730\u70B9\u304C\u898B\u3048\u305F\u3002\u3042\u308C\u3092\u58CA\u305B\u3070\u3001\u3053\u3053\u304B\u3089\u51FA\u3089\u308C\u308B\u3002"
