    _dialogue: "\u30B3\u30A2\u306F\u666E\u901A\u306E\u653B\u6483\u3067\u306F\u58CA\u308C\u306A\u3044\u3002\u4E2D\u5EAD\u306E\u67F1\u306E\u6839\u5143\u3092\u5D29\u3057\u3066\u3001\u30B3\u30A2\u306E\u4E0A\u306E\u6881\u3092\u843D\u3068\u305D\u3046\u3002\u6881\u306F\u6642\u9593\u304C\u305F\u3064\u3068\u5143\u306B\u623B\u308B\u3002"
