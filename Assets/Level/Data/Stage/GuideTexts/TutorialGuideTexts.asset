  m_Script: {fileID: 11500000, guid: 190b3e21da5e01d41a75c1b35ad040d9, type: 3}
  m_Name: TutorialGuideTexts
  m_EditorClassIdentifier: Kizami.EngineAdapter.Runtime::Kizami.EngineAdapter.StageGuideTexts
  _objective: 
  _steps:
  - _subObjective: 
    _dialogue: "\u30AA\u30DA\u30EC\u30FC\u30BF\u30FC\n\u30B3\u30FC\u30C9\u30CD\u30FC\u30E0\u300C\u523B\u65AD\u300D\u3002\u307E\u305A\u306F\u65E7\u5F0F\u8EE2\u79FB\u88C5\u7F6E\u306B\u3088\u308B\u6A5F\u80FD\u969C\u5BB3\u306B\u3064\u3044\u3066\u691C\u67FB\u3059\u308B\u3002\u5C11\u3057\u4F53\u3092\u52D5\u304B\u3057\u3066\u307F\u308D\u3002"
    _hint: "[W][A][S][D] \u79FB\u52D5  [Shift] \u30C0\u30C3\u30B7\u30E5  [Space]
      \u30B8\u30E3\u30F3\u30D7"
  - _subObjective: 
    _dialogue: 
    _hint: "[Space] \u30B8\u30E3\u30F3\u30D7\u3057\u3066\u58C1\u306B\u89E6\u308C\u308B\uFF1A\u30A6\u30A9\u30FC\u30EB\u30E9\u30C3\u30C1  
      \u58C1\u306B\u6CBF\u3063\u3066\u8D70\u308B\uFF1A\u30A6\u30A9\u30FC\u30EB\u30E9\u30F3  
      [Space] \u30A6\u30A9\u30FC\u30EB\u30B8\u30E3\u30F3\u30D7"
  - _subObjective: 
    _dialogue: "\u30AA\u30DA\u30EC\u30FC\u30BF\u30FC\n\u3067\u306F\u6B21\u306F\u89E3\u4F53\u6B66\u88C5\u306E\u78BA\u8A8D\u3060\u3002\u767A\u52D5\u3057\u3066\u307F\u308D\u3002\u5468\u56F2\u306E\u5730\u5F62\u3092\u7834\u58CA\u3067\u304D\u308B\u306F\u305A\u3060\u3002\u3053\u306E\u90FD\u5E02\u306B\u306F\u81EA\u52D5\u4FEE\u5FA9\u6A5F\u69CB\u304C\u5099\u308F\u3063\u3066\u3044\u308B\u3002\u8A66\u3057\u6253\u3061\u3067\u7834\u58CA\u3057\u3066\u3082\u69CB\u308F\u306A\u3044\u3002\u6642\u9593\u306F\u304B\u304B\u308B\u304C\u3001\u3059\u3079\u3066\u7FCC\u65E5\u306B\u306F\u4FEE\u5FA9\u3055\u308C\u308B\u3002"
    _hint: "[1] / [2] \u30B9\u30AD\u30EB\u767A\u52D5"
  - _subObjective: 
    _dialogue: "\u30AA\u30DA\u30EC\u30FC\u30BF\u30FC\n\u3067\u306F\u6B21\u306F\u6226\u8853\u6B66\u88C5\u306E\u30C6\u30B9\u30C8\u3060\u3002\u3053\u3053\u306B\u51FA\u3066\u304F\u308B\u6A5F\u68B0\u578B\u306E\u6575\u306B\u5BFE\u3057\u3066\u6709\u52B9\u3060\u3002\u6025\u6240\u3092\u653B\u6483\u3059\u308C\u3070\u4E00\u6483\u3067\u5012\u305B\u308B\u3046\u3048\u3001\u6B66\u88C5\u3084\u8DB3\u3092\u5207\u308A\u3064\u3051\u3066\u7121\u529B\u5316\u3059\u308B\u3053\u3068\u3082\u53EF\u80FD\u3060\u3002\u30C0\u30DF\u30FC\u3092\u51FA\u3059\u304B\u3089\u5207\u308A\u3064\u3051\u3066\u307F\u308D\u3002"
    _hint: "[\u5DE6\u30AF\u30EA\u30C3\u30AF] \u65AC\u6483"
  - _subObjective: 
    _dialogue: "\u30AA\u30DA\u30EC\u30FC\u30BF\u30FC\n\u8EAB\u4F53\u6A5F\u80FD\u3001\u6B66\u88C5\u3068\u3082\u306B\u7570\u5E38\u306A\u3057\u3002\u3053\u308C\u3088\u308A\u90FD\u5E02\u596A\u9084\u3092\u76EE\u7684\u3068\u3057\u305F\u5148\u884C\u5075\u5BDF\u30FB\u652A\u4E71\u4F5C\u6226\u3092\u958B\u59CB\u3059\u308B\u3002"
    _hint: 
