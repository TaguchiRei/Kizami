  - _subObjective: "\u5965\u306E\u30B2\u30FC\u30C8\u3092\u58CA\u305D\u3046"
    _dialogue: "\u6575\u3092\u5012\u3059\u3068\u3001\u30C1\u30E3\u30FC\u30B8\u304C\u8CAF\u307E\u308A\u307E\u3059\u3002\u5965\u306B\u3042\u308B\u30B2\u30FC\u30C8\u306E\u4E0A\u306E\u90E8\u5206\u3092\u3001\u30B9\u30AD\u30EB\u3067\u58CA\u3057\u307E\u3057\u3087\u3046\u3002\u58CA\u3059\u3068\u3001\u30B9\u30C6\u30FC\u30B8\u30AF\u30EA\u30A2\u3067\u3059\u3002"
