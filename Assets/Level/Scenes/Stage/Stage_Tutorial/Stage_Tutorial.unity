    _releaseSpawnPoints: []
  - _subObjective: "\u8DB3\u5834\u3092\u5D29\u3057\u3066\u6575\u3092\u5012\u305D\u3046"
    _dialogue: "\u5F35\u308A\u51FA\u3057\u305F\u8DB3\u5834\u3068\u67F1\u306E\u3064\u306A\u304E\u76EE\u3092\u58CA\u3059\u3068\u3001\u8DB3\u5834\u304C\u5D29\u308C\u3066\u3001\u4E0B\u306E\u6575\u3092\u62BC\u3057\u6F70\u305B\u307E\u3059\u3002\u30D3\u30FC\u30E0\u3067\u3001\u3064\u306A\u304E\u76EE\u3092\u72D9\u3044\u307E\u3057\u3087\u3046\u3002"
    _condition:
