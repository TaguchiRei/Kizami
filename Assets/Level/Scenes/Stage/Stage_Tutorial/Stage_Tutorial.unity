  m_Name: 
  m_EditorClassIdentifier: Kizami.EngineAdapter.Runtime::Kizami.EngineAdapter.StageGuideScript
  _objective: "\u30B2\u30FC\u30C8\u3092\u58CA\u3057\u3066\u3001\u888B\u5C0F\u8DEF\u304B\u3089\u8131\u51FA\u3057\u308D"
  _steps:
  - _subObjective: "\u79FB\u52D5\u3057\u3066\u307F\u3088\u3046"
    _dialogue: "WASD\u30AD\u30FC\u3067\u79FB\u52D5\u3067\u304D\u307E\u3059\u3002Shift\u30AD\u30FC\u3092\u62BC\u3057\u3066\u3044\u308B\u9593\u306F\u3001\u8D70\u308C\u307E\u3059\u3002"
    _condition:
      _kind: 3
      _target: {fileID: 0}
      _count: 1
      _action: 3
    _releaseSpawnPoints: []
  - _subObjective: "\u6BB5\u5DEE\u3092\u98DB\u3073\u8D8A\u3048\u3088\u3046"
    _dialogue: "\u30B9\u30DA\u30FC\u30B9\u30AD\u30FC\u3067\u30B8\u30E3\u30F3\u30D7\u3057\u307E\u3059\u3002\u76EE\u306E\u524D\u306E\u6BB5\u5DEE\u3092\u98DB\u3073\u8D8A\u3048\u307E\u3057\u3087\u3046\u3002"
    _condition:
      _kind: 2
      _target: {fileID: 0}
      _count: 1
      _action: 3
    _releaseSpawnPoints: []
  - _subObjective: "\u58C1\u3092\u8D70\u308D\u3046"
    _dialogue: "\u7A7A\u4E2D\u3067\u58C1\u306B\u89E6\u308C\u306A\u304C\u3089\u524D\u3078\u9032\u3080\u3068\u3001\u58C1\u3092\u8D70\u308C\u307E\u3059\u3002\u30B8\u30E3\u30F3\u30D7\u3057\u3066\u3001\u58C1\u3078\u5411\u304B\u3063\u3066\u9032\u307F\u307E\u3057\u3087\u3046\u3002"
    _condition:
      _kind: 2
      _target: {fileID: 0}
      _count: 1
      _action: 4
    _releaseSpawnPoints: []
  - _subObjective: "\u58C1\u30AD\u30C3\u30AF\u3067\u9AD8\u3044\u8DB3\u5834\u3078\u767B\u308D\u3046"
    _dialogue: "\u58C1\u3092\u8D70\u3063\u3066\u3044\u308B\u9593\u306B\u30B8\u30E3\u30F3\u30D7\u3059\u308B\u3068\u3001\u58C1\u3092\u8E74\u3063\u3066\u53CD\u5BFE\u5074\u306E\u58C1\u3078\u8DF3\u3079\u307E\u3059\u3002\u58C1\u30AD\u30C3\u30AF\u3092\u7E70\u308A\u8FD4\u3057\u3066\u3001\u5965\u306E\u9AD8\u3044\u8DB3\u5834\u3078\u767B\u308A\u307E\u3057\u3087\u3046\u3002"
    _condition:
      _kind: 2
      _target: {fileID: 0}
      _count: 1
      _action: 5
    _releaseSpawnPoints: []
  - _subObjective: "\u30B9\u30AD\u30EB\u3067\u58C1\u3092\u58CA\u305D\u3046"
    _dialogue: "\u884C\u304F\u624B\u3092\u58C1\u304C\u3075\u3055\u3044\u3067\u3044\u307E\u3059\u3002\u30C1\u30E3\u30FC\u30B8\u306F\u8CAF\u307E\u3063\u3066\u3044\u307E\u3059\u30021\u30AD\u30FC\u306E\u30D3\u30FC\u30E0\u3067\u58C1\u3092\u58CA\u3057\u307E\u3057\u3087\u3046\u3002\u7A74\u306E\u4E0B\u306B\u4F4E\u3044\u6BB5\u304C\u6B8B\u308B\u306E\u3067\u3001\u30B8\u30E3\u30F3\u30D7\u3057\u3066\u629C\u3051\u307E\u3059\u3002"
    _condition:
      _kind: 0
      _target: {fileID: 613527837}
      _count: 1
      _action: 3
    _releaseSpawnPoints: []
  - _subObjective: "\u9632\u8B77\u67F5\u3092\u58CA\u305D\u3046"
    _dialogue: "\u884C\u304F\u624B\u3092\u9632\u8B77\u67F5\u304C\u3075\u3055\u3044\u3067\u3044\u307E\u3059\u3002\u67F5\u306E\u5411\u3053\u3046\u306F\u5E83\u5834\u3067\u3001\u6575\u304C\u5F85\u3061\u69CB\u3048\u3066\u3044\u307E\u3059\u3002\u30D3\u30FC\u30E0\u3067\u67F5\u3092\u58CA\u3057\u307E\u3057\u3087\u3046\u3002\u58CA\u3059\u3068\u3001\u6575\u304C\u6483\u3063\u3066\u304D\u307E\u3059\u3002"
