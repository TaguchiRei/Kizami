    _releaseSpawnPoints: []
  - _subObjective: "\u6575\u3092\u5207\u3063\u3066\u5012\u305D\u3046"
    _dialogue: "\u5E83\u5834\u306E\u6575\u306F3\u7A2E\u985E\u3067\u3059\u3002\u30A2\u30BF\u30C3\u30AB\u30FC\u306F\u9060\u304F\u304B\u3089\u6483\u3061\u3001\u30C7\u30A3\u30D5\u30A7\u30F3\u30C0\u30FC\u306F\u30D0\u30EA\u30A2\u3092\u5F35\u308A\u307E\u3059\u3002\u30D5\u30A3\u30CB\u30C3\u30B7\u30E3\u30FC\u306F\u672C\u6765\u3001\u4EF2\u9593\u3092\u5438\u53CE\u3057\u3066\u7279\u5927\u306E\u30D3\u30FC\u30E0\u3092\u6483\u3061\u307E\u3059\u3002\u5DE6\u30AF\u30EA\u30C3\u30AF\u3067\u3001\u6575\u3092\u5207\u3063\u3066\u5012\u3057\u307E\u3057\u3087\u3046\u3002"
    _condition:
      _kind: 1
      _target: {fileID: 0}
      _count: 1
